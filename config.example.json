{
  "settings": {
    "haUrl": "http://homeassistant.local:8123",
    "accessToken": "replace-with-a-long-lived-access-token",
    "imageScheduleTimezone": "Asia/Bangkok",
    "configUsername": "admin",
    "configPassword": "change-this-editor-password"
  },
  "customCsses": [
    {
      "id": "eink-cards",
      "css": "ha-card { border: 0 !important; box-shadow: none !important; }"
    },
    {
      "id": "compact-layout",
      "css": ".card-content { padding: 8px !important; }"
    }
  ],
  "tasks": [
    {
      "id": "overview",
      "dashboardPath": "/lovelace/0?kiosk",
      "width": 800,
      "height": 480,
      "refreshIntervalSeconds": 60,
      "maximumImageAgeSeconds": 180,
      "retryAttempts": 2,
      "retryInitialDelaySeconds": 2,
      "retryMaximumDelaySeconds": 30,
      "waitAfterLoadMs": 3000,
      "colorScheme": "light",
      "timezone": "Asia/Bangkok",
      "disableAnimations": true,
      "customCssIds": ["eink-cards", "compact-layout"],
      "customCss": ".task-only { display: none !important; }",
      "zoom": 1,
      "format": "png",
      "imageProcessing": {
        "mode": "monochrome",
        "palette": [],
        "dither": "atkinson",
        "threshold": 128,
        "invert": false,
        "rotation": 0
      }
    },
    {
      "id": "details",
      "dashboardPath": "/lovelace/1?kiosk",
      "width": 800,
      "height": 480,
      "refreshIntervalSeconds": 300,
      "maximumImageAgeSeconds": 900,
      "retryAttempts": 2,
      "retryInitialDelaySeconds": 2,
      "retryMaximumDelaySeconds": 30,
      "waitAfterLoadMs": 5000,
      "colorScheme": "dark",
      "timezone": "Asia/Bangkok",
      "disableAnimations": false,
      "zoom": 0.9,
      "format": "png"
    }
  ],
  "images": [
    {
      "id": "hallway-display",
      "fallbackTaskId": "overview",
      "slots": [
        {
          "days": ["mon", "tue", "wed", "thu", "fri"],
          "start": "18:00",
          "end": "23:00",
          "taskId": "details"
        }
      ]
    }
  ]
}
