# Home Assistant base URL as reachable from inside this container.
HA_URL=http://homeassistant.local:8123
HA_ACCESS_TOKEN=replace-with-a-long-lived-access-token

# Host-side path for direct Node.js runs. Compose overrides this with
# /config/config.json and mounts the entire ./config directory at /config.
CONFIG_FILE=./config/config.json
IMAGE_SCHEDULE_TIMEZONE=UTC

# Credentials for /admin and configuration APIs. Image URLs remain public.
CONFIG_USERNAME=admin
CONFIG_PASSWORD=replace-with-a-strong-editor-password

# Shared service settings.
OUTPUT_DIRECTORY=./data
IGNORE_HTTPS_ERRORS=false
PORT=3000
